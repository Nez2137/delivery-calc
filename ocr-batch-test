<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>OCR Batch Test — Ticket Scan</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #0a0a0a; --surface: #141414; --surface2: #1c1c1c; --border: #2a2a2a;
    --blue: #60c0f0; --green: #4caf50; --orange: #ff6b35; --red: #ff4444;
    --text: #fff; --muted: #888; --faint: #444;
  }
  body {
    background: var(--bg); color: var(--text);
    font-family: -apple-system, system-ui, sans-serif;
    min-height: 100vh; padding: 0 0 48px;
    -webkit-tap-highlight-color: transparent;
  }
  .header {
    background: linear-gradient(160deg, #8b0000 0%, #6b0000 60%, #4a0000 100%);
    padding: 18px 16px; border-bottom: 2px solid #cc0000; position: sticky; top: 0; z-index: 10;
  }
  .header h1 { font-size: 18px; font-weight: 700; letter-spacing: 0.5px; }
  .header p { font-size: 12px; color: rgba(255,255,255,0.7); margin-top: 3px; }
  .wrap { padding: 16px; max-width: 560px; margin: 0 auto; }

  .btn {
    width: 100%; border-radius: 14px; padding: 16px; font-size: 16px; font-weight: 600;
    cursor: pointer; letter-spacing: 0.5px; border: 1px solid; transition: background 0.15s;
  }
  .btn-cam { background: rgba(96,192,240,0.15); border-color: var(--blue); color: var(--blue); }
  .btn-cam:active { background: rgba(96,192,240,0.3); }
  .btn-read { background: var(--green); border-color: var(--green); color: #fff; margin-top: 12px; }
  .btn-read:active { opacity: 0.85; }
  .btn-read:disabled { opacity: 0.4; }
  .btn-ghost { background: var(--surface2); border-color: var(--border); color: var(--text); margin-top: 12px; }
  .btn-ghost:active { background: #262626; }

  /* ── Capture queue ── */
  .queue-head { display: flex; justify-content: space-between; align-items: center; margin: 20px 0 10px; }
  .queue-head h2 { font-size: 13px; color: var(--muted); font-weight: 500; letter-spacing: 0.5px; text-transform: uppercase; }
  .queue-count { font-size: 13px; color: var(--blue); font-variant-numeric: tabular-nums; }
  .queue-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: 8px; }
  .thumb {
    position: relative; aspect-ratio: 3/4; border-radius: 10px; overflow: hidden;
    border: 1px solid var(--border); background: #000;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-num {
    position: absolute; top: 4px; left: 4px; background: rgba(0,0,0,0.7); color: #fff;
    font-size: 11px; font-weight: 700; padding: 2px 6px; border-radius: 6px; font-variant-numeric: tabular-nums;
  }
  .thumb-del {
    position: absolute; top: 4px; right: 4px; background: rgba(0,0,0,0.7); color: var(--red);
    border: none; width: 22px; height: 22px; border-radius: 6px; font-size: 15px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; line-height: 1;
  }
  .thumb-status {
    position: absolute; inset: 0; background: rgba(0,0,0,0.65); display: none;
    align-items: center; justify-content: center; flex-direction: column; gap: 6px;
  }
  .thumb.reading .thumb-status { display: flex; }
  .thumb.done .thumb-status { display: flex; background: rgba(0,0,0,0.55); }
  .thumb-spin { width: 20px; height: 20px; border: 3px solid rgba(96,192,240,0.3); border-top-color: var(--blue); border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .thumb-tick { font-size: 22px; color: var(--green); }
  .thumb-fail { font-size: 22px; color: var(--orange); }

  /* ── Progress bar ── */
  .progress-wrap { margin-top: 16px; display: none; }
  .progress-wrap.show { display: block; }
  .progress-label { font-size: 13px; color: var(--blue); margin-bottom: 8px; font-variant-numeric: tabular-nums; }
  .progress-track { height: 8px; background: var(--surface2); border-radius: 4px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--blue); width: 0%; transition: width 0.3s; }

  /* ── Review list ── */
  .review { margin-top: 24px; display: none; }
  .review.show { display: block; }
  .review-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
  .review-head h2 { font-size: 15px; font-weight: 700; }
  .review-summary { font-size: 12px; color: var(--muted); }

  .rev-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    padding: 14px; margin-bottom: 10px;
  }
  .rev-card.fail { border-color: rgba(255,107,53,0.5); }
  .rev-top { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .rev-thumb { width: 40px; height: 52px; border-radius: 8px; object-fit: cover; border: 1px solid var(--border); flex-shrink: 0; }
  .rev-title { font-size: 13px; color: var(--muted); flex: 1; }
  .rev-raw-btn { background: none; border: 1px solid var(--border); color: var(--muted); font-size: 11px; padding: 4px 9px; border-radius: 7px; cursor: pointer; }
  .rev-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-top: 1px solid var(--border); }
  .rev-label { font-size: 14px; color: var(--muted); }
  .rev-field { display: flex; align-items: center; gap: 4px; }
  .rev-input {
    background: #0f0f0f; border: 1px solid #333; border-radius: 8px; padding: 7px 9px;
    color: #fff; font-family: ui-monospace, monospace; font-size: 16px; width: 92px; text-align: right;
    -moz-appearance: textfield; appearance: textfield;
  }
  .rev-input::-webkit-outer-spin-button, .rev-input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .rev-input.missing { border-color: var(--orange); }
  .rev-raw {
    display: none; margin-top: 10px; background: #0a0a0a; border: 1px solid var(--border);
    border-radius: 8px; padding: 10px; font-family: ui-monospace, monospace; font-size: 12px;
    color: #a8e6b0; white-space: pre-wrap; word-break: break-word; line-height: 1.6; max-height: 200px; overflow-y: auto;
  }
  .rev-raw.show { display: block; }

  .tip { margin-top: 20px; font-size: 12px; color: var(--faint); line-height: 1.7; text-align: center; }
  .empty { text-align: center; color: var(--faint); font-size: 13px; padding: 30px 0; line-height: 1.7; }
</style>
</head>
<body>
  <div class="header">
    <h1>🧾 OCR Batch Test</h1>
    <p>Scan multiple tickets · Tesseract.js · runs on your phone</p>
  </div>

  <div class="wrap">
    <button class="btn btn-cam" onclick="document.getElementById('file').click()">📸 Add Ticket Photo</button>
    <input type="file" accept="image/*" capture="environment" id="file" style="display:none" onchange="handleCapture(event)">

    <div class="queue-head">
      <h2>Photos to read</h2>
      <span class="queue-count" id="queueCount">0</span>
    </div>
    <div id="queueArea">
      <div class="empty" id="queueEmpty">No photos yet.<br>Tap “Add Ticket Photo” and build up your stack.</div>
      <div class="queue-grid" id="queueGrid"></div>
    </div>

    <button class="btn btn-read" id="readBtn" onclick="readAll()" disabled>Read all tickets</button>

    <div class="progress-wrap" id="progressWrap">
      <div class="progress-label" id="progressLabel">Reading 0 of 0…</div>
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
    </div>

    <div class="review" id="review">
      <div class="review-head">
        <h2>Results</h2>
        <span class="review-summary" id="reviewSummary"></span>
      </div>
      <div id="reviewList"></div>
      <button class="btn btn-ghost" onclick="resetAll()">Clear & start over</button>
      <div class="tip">
        This is the test page — values aren’t added anywhere yet.<br>
        Green = read · Orange = check it.<br>
        Tap “raw” on any ticket to see exactly what Tesseract read.
      </div>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<script>
// ── State ────────────────────────────────────────────────────
let tickets = [];          // { id, thumbUrl, blob, status, order, deliv, raw }
let nextId = 1;
let worker = null;         // single reused Tesseract worker
const MAX_WIDTH = 1500;    // shrink target — plenty for OCR, light on memory

// ── Capture + shrink ─────────────────────────────────────────
async function handleCapture(ev) {
  const file = ev.target.files && ev.target.files[0];
  ev.target.value = '';
  if (!file) return;

  const shrunk = await shrinkImage(file);   // returns a Blob
  const id = nextId++;
  tickets.push({
    id, blob: shrunk, thumbUrl: URL.createObjectURL(shrunk),
    status: 'pending', order: null, deliv: null, raw: ''
  });
  renderQueue();
}

function shrinkImage(file) {
  return new Promise((resolve) => {
    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      let { width, height } = img;
      if (width > MAX_WIDTH) {
        height = Math.round(height * (MAX_WIDTH / width));
        width = MAX_WIDTH;
      }
      const canvas = document.createElement('canvas');
      canvas.width = width; canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, width, height);
      URL.revokeObjectURL(url);
      canvas.toBlob(b => resolve(b || file), 'image/jpeg', 0.85);
    };
    img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
    img.src = url;
  });
}

// ── Queue render ─────────────────────────────────────────────
function renderQueue() {
  const grid = document.getElementById('queueGrid');
  const empty = document.getElementById('queueEmpty');
  document.getElementById('queueCount').textContent = tickets.length;
  document.getElementById('readBtn').disabled = tickets.length === 0;
  empty.style.display = tickets.length ? 'none' : 'block';

  grid.innerHTML = '';
  tickets.forEach((t, i) => {
    const div = document.createElement('div');
    div.className = 'thumb' + (t.status === 'reading' ? ' reading' : '') + (t.status === 'done' || t.status === 'fail' ? ' done' : '');
    let statusInner = '';
    if (t.status === 'reading') statusInner = '<div class="thumb-spin"></div>';
    else if (t.status === 'done') statusInner = '<div class="thumb-tick">✓</div>';
    else if (t.status === 'fail') statusInner = '<div class="thumb-fail">!</div>';
    div.innerHTML =
      '<img src="' + t.thumbUrl + '">' +
      '<span class="thumb-num">' + (i + 1) + '</span>' +
      (t.status === 'pending' ? '<button class="thumb-del" onclick="removeTicket(' + t.id + ')">✕</button>' : '') +
      '<div class="thumb-status">' + statusInner + '</div>';
    grid.appendChild(div);
  });
}

function removeTicket(id) {
  const t = tickets.find(x => x.id === id);
  if (t) URL.revokeObjectURL(t.thumbUrl);
  tickets = tickets.filter(x => x.id !== id);
  renderQueue();
}

// ── Worker (created once, reused) ────────────────────────────
async function getWorker() {
  if (worker) return worker;
  worker = await Tesseract.createWorker('eng');
  return worker;
}

// ── Read all — sequential ────────────────────────────────────
async function readAll() {
  if (!tickets.length) return;
  document.getElementById('readBtn').disabled = true;
  document.getElementById('file').disabled = true;
  const pw = document.getElementById('progressWrap');
  pw.classList.add('show');

  const w = await getWorker();
  const total = tickets.length;

  for (let i = 0; i < total; i++) {
    const t = tickets[i];
    updateProgress(i, total);
    t.status = 'reading';
    renderQueue();

    try {
      const { data } = await w.recognize(t.blob);
      t.raw = data.text || '';
      t.order = extractTotal(t.raw);
      t.deliv = extractValue(t.raw, ['delivery', 'deliverv', 'del charge', 'del ']);
      t.status = (t.order != null || t.deliv != null) ? 'done' : 'fail';
    } catch (e) {
      t.raw = 'ERROR: ' + e.message;
      t.status = 'fail';
    }
    renderQueue();
  }

  updateProgress(total, total);
  setTimeout(() => pw.classList.remove('show'), 400);
  showReview();
}

function updateProgress(done, total) {
  document.getElementById('progressLabel').textContent = 'Reading ' + Math.min(done + 1, total) + ' of ' + total + '…';
  if (done >= total) document.getElementById('progressLabel').textContent = 'Done — ' + total + ' tickets read';
  document.getElementById('progressFill').style.width = Math.round((done / total) * 100) + '%';
}

// ── Parsing ──────────────────────────────────────────────────
function extractTotal(text) {
  const lines = text.split('\n');
  let candidate = null;
  for (const line of lines) {
    const lower = line.toLowerCase();
    if (lower.includes('total') && !lower.includes('sub')) {
      const m = line.match(/\d+[.,]\d{2}/g);
      if (m && m.length) candidate = parseFloat(m[m.length - 1].replace(',', '.'));
    }
  }
  return candidate;
}
function extractValue(text, labels) {
  const lines = text.split('\n');
  for (const line of lines) {
    const lower = line.toLowerCase();
    if (labels.some(l => lower.includes(l))) {
      const m = line.match(/\d+[.,]\d{2}/g);
      if (m && m.length) return parseFloat(m[m.length - 1].replace(',', '.'));
      const loose = line.match(/\d+(?:[.,]\d+)?/g);
      if (loose && loose.length) return parseFloat(loose[loose.length - 1].replace(',', '.'));
    }
  }
  return null;
}

// ── Review render ────────────────────────────────────────────
function showReview() {
  const list = document.getElementById('reviewList');
  list.innerHTML = '';
  let readCount = 0;

  tickets.forEach((t, i) => {
    if (t.order != null || t.deliv != null) readCount++;
    const orderVal = t.order != null ? t.order.toFixed(2) : '';
    const delivVal = t.deliv != null ? t.deliv.toFixed(2) : '';
    const card = document.createElement('div');
    card.className = 'rev-card' + (t.status === 'fail' ? ' fail' : '');
    card.innerHTML =
      '<div class="rev-top">' +
        '<img class="rev-thumb" src="' + t.thumbUrl + '">' +
        '<span class="rev-title">Ticket ' + (i + 1) + '</span>' +
        '<button class="rev-raw-btn" onclick="toggleRaw(' + t.id + ')">raw</button>' +
      '</div>' +
      '<div class="rev-row"><span class="rev-label">🧾 TOTAL → Cash Orders</span>' +
        '<div class="rev-field">£ <input class="rev-input' + (t.order == null ? ' missing' : '') + '" type="number" inputmode="decimal" value="' + orderVal + '" placeholder="—"></div></div>' +
      '<div class="rev-row"><span class="rev-label">🚗 Delivery Charge</span>' +
        '<div class="rev-field">£ <input class="rev-input' + (t.deliv == null ? ' missing' : '') + '" type="number" inputmode="decimal" value="' + delivVal + '" placeholder="—"></div></div>' +
      '<div class="rev-raw" id="raw-' + t.id + '">' + escapeHtml(t.raw.trim() || '(nothing read)') + '</div>';
    list.appendChild(card);
  });

  document.getElementById('reviewSummary').textContent = readCount + ' of ' + tickets.length + ' read';
  document.getElementById('review').classList.add('show');
  document.getElementById('review').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function toggleRaw(id) { document.getElementById('raw-' + id).classList.toggle('show'); }
function escapeHtml(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

// ── Reset ────────────────────────────────────────────────────
function resetAll() {
  tickets.forEach(t => URL.revokeObjectURL(t.thumbUrl));
  tickets = [];
  document.getElementById('review').classList.remove('show');
  document.getElementById('file').disabled = false;
  renderQueue();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

renderQueue();
</script>
</body>
</html>
